# Static asset responses bypass the Worker, so their security headers live
# here. Server-rendered pages get theirs from src/platform/security-headers.ts.
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Strict-Transport-Security: max-age=63072000; includeSubDomains

# Vite fingerprints everything under /assets, so it never changes in place.
/assets/*
  Cache-Control: public, max-age=31536000, immutable
