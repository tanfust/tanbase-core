{
  "name": "tanbase-core",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.11.1",
  "engines": {
    "node": "^22.13.0 || >=24.0.0"
  },
  "scripts": {
    "dev": "vite dev --port 3000",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:boundaries": "node scripts/test-import-protection.mjs && node scripts/check-db-boundaries.mjs",
    "lint": "eslint .",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,mjs,json,jsonc,md,yml,yaml}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,mjs,json,jsonc,md,yml,yaml}\"",
    "check": "pnpm format:check && pnpm lint",
    "docs:check": "node scripts/check-docs.mjs",
    "typecheck": "tsc --noEmit",
    "verify": "pnpm format:check && pnpm lint && pnpm docs:check && pnpm db:check && pnpm typecheck && pnpm test && pnpm test:boundaries && pnpm build",
    "db:generate": "drizzle-kit generate",
    "db:check": "drizzle-kit check",
    "db:migrate:local": "wrangler d1 migrations apply DB --env preview --local",
    "db:migrate:preview": "wrangler d1 migrations apply DB --env preview --remote",
    "db:migrate:production": "wrangler d1 migrations apply DB --env production --remote",
    "db:seed:local": "wrangler d1 execute DB --env preview --local --file scripts/seed.sql",
    "cf:typegen": "wrangler types src/worker-configuration.d.ts",
    "cf:build:preview": "cross-env CLOUDFLARE_ENV=preview vite build",
    "cf:build:production": "cross-env CLOUDFLARE_ENV=production vite build",
    "cf:dry-run:preview": "pnpm cf:build:preview && wrangler versions upload --dry-run",
    "cf:dry-run:production": "pnpm cf:build:production && wrangler deploy --dry-run",
    "cf:upload:preview": "pnpm cf:build:preview && pnpm db:migrate:preview && wrangler versions upload",
    "cf:deploy:production": "pnpm cf:build:production && pnpm db:migrate:production && wrangler deploy",
    "smoke": "node scripts/smoke.mjs"
  },
  "dependencies": {
    "@base-ui/react": "1.8.0",
    "@fontsource-variable/inter": "5.3.0",
    "@shadcn/react": "0.3.1",
    "@tailwindcss/vite": "4.3.3",
    "@tanstack/react-devtools": "0.10.12",
    "@tanstack/react-router": "1.170.36",
    "@tanstack/react-router-devtools": "1.167.2",
    "@tanstack/react-router-ssr-query": "1.167.2",
    "@tanstack/react-start": "1.168.54",
    "@tanstack/router-plugin": "1.168.38",
    "class-variance-authority": "0.7.1",
    "cmdk": "1.1.1",
    "cn": "0.2.6",
    "date-fns": "4.4.0",
    "drizzle-orm": "0.45.2",
    "embla-carousel-react": "8.6.0",
    "input-otp": "1.5.0",
    "lucide-react": "1.46.0",
    "react": "19.3.0",
    "react-day-picker": "10.0.1",
    "react-dom": "19.3.0",
    "react-resizable-panels": "4.12.4",
    "recharts": "3.8.0",
    "shadcn": "4.21.0",
    "tailwindcss": "4.3.3",
    "tw-animate-css": "1.4.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.54.4",
    "@cloudflare/vitest-plugin": "1.1.11",
    "@tanstack/devtools-vite": "0.8.5",
    "@tanstack/eslint-config": "0.4.0",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@types/node": "20.19.43",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "cross-env": "10.1.0",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.5",
    "jsdom": "30.0.1",
    "prettier": "3.9.7",
    "prettier-plugin-tailwindcss": "0.8.1",
    "typescript": "6.0.3",
    "vite": "8.3.0",
    "vitest": "4.1.11",
    "wrangler": "4.129.0"
  }
}
