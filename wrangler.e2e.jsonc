{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tanbase-core-e2e",
  "main": "src/server.ts",
  "compatibility_date": "2026-09-03",
  "compatibility_flags": ["nodejs_compat"],
  "preview_urls": false,
  "vars": {
    "APP_ENV": "local",
    "BETTER_AUTH_URL": "http://localhost:3110",
    "EMAIL_FROM": "",
    "TURNSTILE_SITE_KEY": "1x00000000000000000000AA",
    "AI_MODEL": "@cf/mistralai/mistral-small-3.1-24b-instruct",
    "AI_GATEWAY_ID": "default",
    "AI_DAILY_LIMIT": "20",
  },
  "ratelimits": [
    {
      "name": "AUTH_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 10, "period": 60 },
    },
    {
      "name": "AI_LIMITER",
      "namespace_id": "1002",
      "simple": { "limit": 5, "period": 60 },
    },
  ],
  "version_metadata": { "binding": "CF_VERSION_METADATA" },
  "durable_objects": {
    "bindings": [{ "name": "BOARD", "class_name": "BoardRoom" }],
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["BoardRoom"] }],
  "workflows": [
    {
      "name": "tanbase-core-task-breakdown-e2e",
      "binding": "BREAKDOWN",
      "class_name": "TaskBreakdownWorkflow",
    },
  ],
  "queues": {
    "producers": [
      { "binding": "EMAIL_QUEUE", "queue": "tanbase-core-email-e2e" },
    ],
    "consumers": [
      {
        "queue": "tanbase-core-email-e2e",
        "max_retries": 3,
        "retry_delay": 120,
        "dead_letter_queue": "tanbase-core-email-dlq-e2e",
      },
    ],
  },
  "triggers": { "crons": ["0 * * * *"] },
  "r2_buckets": [
    {
      "binding": "FILES",
      "bucket_name": "tanbase-core-files-e2e",
    },
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "tanbase-core-e2e",
      "migrations_dir": "drizzle",
      "migrations_pattern": "drizzle/migrations/*.sql",
    },
  ],
}
