{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tanbase-core-e2e",
  "main": "src/server.ts",
  "compatibility_date": "2026-09-03",
  "compatibility_flags": ["nodejs_compat"],
  "preview_urls": false,
  "vars": {
    "APP_ENV": "local",
    "BETTER_AUTH_URL": "http://localhost:3110",
    "EMAIL_FROM": "",
    "TURNSTILE_SITE_KEY": "1x00000000000000000000AA",
  },
  "ratelimits": [
    {
      "name": "AUTH_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 10, "period": 60 },
    },
  ],
  "durable_objects": {
    "bindings": [{ "name": "BOARD", "class_name": "BoardRoom" }],
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["BoardRoom"] }],
  "r2_buckets": [
    {
      "binding": "FILES",
      "bucket_name": "tanbase-core-files-e2e",
    },
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "tanbase-core-e2e",
      "migrations_dir": "drizzle",
      "migrations_pattern": "drizzle/migrations/*.sql",
    },
  ],
}
